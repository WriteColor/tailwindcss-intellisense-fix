{
  "include": ["src", "../../types", "../tailwindcss-class-fixer/src"],
  "compilerOptions": {
    "module": "ES2022",
    "lib": ["ES2022"],
    "target": "ES2022",
    "importHelpers": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "..",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "jsx": "react",
    "esModuleInterop": true,
    "isolatedDeclarations": true,
    "baseUrl": ".",
    "paths": {
      "@tailwindcss/class-fixer": ["../tailwindcss-class-fixer/src/index.ts"],
      "@tailwindcss/class-fixer/*": ["../tailwindcss-class-fixer/src/*"]
    }
  }
}
