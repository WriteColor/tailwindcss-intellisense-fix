{
  "name": "tailwindcss-intellisense-fix",
  "version": "0.16.1",
  "displayName": "Tailwind CSS IntelliSense Fix & Auto-Optimizer",
  "description": "Next-generation intelligent Tailwind CSS tooling, auto-repair, conflict resolution, canonical sorting, and universal template support by WriteColor.",
  "author": "WriteColor",
  "license": "MIT",
  "homepage": "https://github.com/WriteColor/tailwindcss-intellisense-fix",
  "bugs": {
    "url": "https://github.com/WriteColor/tailwindcss-intellisense-fix/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WriteColor/tailwindcss-intellisense-fix.git"
  },
  "publisher": "writecolor",
  "publisherDisplayName": "WriteColor",
  "keywords": [
    "tailwind",
    "tailwindcss",
    "css",
    "intellisense",
    "autocomplete",
    "autofix",
    "fixer",
    "sorter",
    "vscode"
  ],

  "engines": {
    "vscode": "^1.67.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "galleryBanner": {
    "color": "#f9fafb"
  },
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "tailwindcss",
        "aliases": [
          "Tailwind CSS"
        ],
        "configuration": "./tailwindcss.language.configuration.json",
        "icon": {
          "light": "media/icon.png",
          "dark": "media/icon.png"
        }
      }
    ],
    "commands": [
      {
        "command": "tailwindFix.showOutput",
        "category": "Tailwind CSS IntelliSense Fix",
        "title": "Show Output Channel",
        "enablement": "tailwindFix.hasOutputChannel"
      },
      {
        "command": "tailwindFix.sortSelection",
        "category": "Tailwind CSS IntelliSense Fix",
        "title": "Sort Selected Classes",
        "enablement": "editorHasSelection && (resourceScheme == file || resourceScheme == vscode-remote) && tailwindFix.activeTextEditorSupportsClassSorting"
      },
      {
        "command": "tailwindFix.fixAll",
        "category": "Tailwind CSS IntelliSense Fix",
        "title": "Fix, Optimize & Sort Classes in Current File",
        "enablement": "(resourceScheme == file || resourceScheme == vscode-remote)",
        "icon": "$(sparkle)"
      },
      {
        "command": "tailwindFix.fixWorkspace",
        "category": "Tailwind CSS IntelliSense Fix",
        "title": "Fix All Tailwind Issues in Entire Workspace",
        "enablement": "(resourceScheme == file || resourceScheme == vscode-remote)"
      },
      {
        "command": "tailwindFix.fixExplorerSelection",
        "category": "Tailwind CSS IntelliSense Fix",
        "title": "Fix Tailwind Issues in Selected File(s) / Folder(s)",
        "enablement": "(resourceScheme == file || resourceScheme == vscode-remote)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "tailwindFix.fixAll",
          "group": "1_modification@100",
          "when": "editorTextFocus"
        },
        {
          "command": "tailwindFix.sortSelection",
          "group": "1_modification@101",
          "when": "editorHasSelection"
        }
      ],
      "editor/title/context": [
        {
          "command": "tailwindFix.fixAll",
          "group": "1_modification"
        }
      ],
      "explorer/context": [
        {
          "command": "tailwindFix.fixExplorerSelection",
          "group": "7_modification"
        }
      ],
      "editor/title": [
        {
          "command": "tailwindFix.fixAll",
          "group": "navigation",
          "when": "resourceScheme == file || resourceScheme == vscode-remote"
        }
      ]
    },

    "grammars": [
      {
        "language": "tailwindcss",
        "scopeName": "source.css.tailwind",
        "path": "./syntaxes/source.css.tailwind.tmLanguage.json",
        "tokenTypes": {
          "meta.function.url string.quoted": "other"
        }
      },
      {
        "scopeName": "tailwindcss.at-rules.injection",
        "path": "./syntaxes/at-rules.tmLanguage.json",
        "injectTo": [
          "source.css",
          "source.vue",
          "source.svelte",
          "text.html",
          "source.gjs",
          "source.gts"
        ]
      },
      {
        "scopeName": "tailwindcss.at-rules.scss.injection",
        "path": "./syntaxes/at-rules.scss.tmLanguage.json",
        "injectTo": [
          "source.css.scss"
        ]
      },
      {
        "scopeName": "tailwindcss.at-rules.postcss.injection",
        "path": "./syntaxes/at-rules.postcss.tmLanguage.json",
        "injectTo": [
          "source.css.postcss"
        ]
      },
      {
        "scopeName": "tailwindcss.at-apply.injection",
        "path": "./syntaxes/at-apply.tmLanguage.json",
        "injectTo": [
          "source.css",
          "source.css.postcss",
          "source.vue",
          "source.svelte",
          "text.html",
          "source.gjs",
          "source.gts"
        ]
      },
      {
        "scopeName": "tailwindcss.theme-fn.injection",
        "path": "./syntaxes/theme-fn.tmLanguage.json",
        "injectTo": [
          "source.css",
          "source.css.postcss",
          "source.vue",
          "source.svelte",
          "text.html",
          "source.gjs",
          "source.gts"
        ]
      },
      {
        "scopeName": "tailwindcss.screen-fn.injection",
        "path": "./syntaxes/screen-fn.tmLanguage.json",
        "injectTo": [
          "source.css",
          "source.css.postcss",
          "source.vue",
          "source.svelte",
          "text.html",
          "source.gjs",
          "source.gts"
        ]
      }
    ],
    "configuration": {
      "title": "Tailwind CSS IntelliSense Fix & Auto-Optimizer",
      "properties": {

        "tailwindFix.autoFix.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable automatic class deduplication, conflict resolution, migration and canonical sorting."
        },
        "tailwindFix.autoFix.dedupe": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Automatically deduplicate identical Tailwind CSS classes."
        },
        "tailwindFix.autoFix.resolveConflicts": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Automatically resolve conflicting utility classes on the same element."
        },
        "tailwindFix.autoFix.sort": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Automatically sort classes in canonical order matching official Tailwind recommendations."
        },
        "tailwindFix.autoFix.migrateVersion": {
          "type": "string",
          "enum": ["v4", "v3", "off"],
          "default": "v4",
          "markdownDescription": "Automatically migrate deprecated Tailwind utility classes to target version."
        },
        "tailwindFix.autoFix.fixTypos": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Automatically correct common typographical errors in Tailwind class names."
        },
        "tailwindFix.emmetCompletions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable class name completions when using Emmet-style syntax, for example `div.bg-red-500.uppercase`"
        },
        "tailwindFix.includeLanguages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Enable features in languages that are not supported by default. Add a mapping here between the new language and an already supported language.\n E.g.: `{\"plaintext\": \"html\"}`"
        },
        "tailwindFix.files.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/.hg/**",
            "**/.svn/**"
          ],
          "markdownDescription": "Configure glob patterns to exclude from all IntelliSense features. Inherits all glob patterns from the `#files.exclude#` setting."
        },
        "tailwindFix.classAttributes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "class",
            "className",
            "ngClass",
            "class:list"
          ],
          "markdownDescription": "The HTML attributes for which to provide class completions, hover previews, linting etc."
        },
        "tailwindFix.classFunctions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "The function or tagged template literal names for which to provide class completions, hover previews, linting etc."
        },
        "tailwindFix.suggestions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable autocomplete suggestions.",
          "scope": "language-overridable"
        },
        "tailwindFix.hovers": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable hovers.",
          "scope": "language-overridable"
        },
        "tailwindFix.codeActions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable code actions.",
          "scope": "language-overridable"
        },
        "tailwindFix.codeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable code lens.",
          "scope": "language-overridable"
        },
        "tailwindFix.colorDecorators": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Controls whether the editor should render inline color decorators for Tailwind CSS classes and helper functions.",
          "scope": "language-overridable"
        },
        "tailwindFix.validate": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable linting. Rules can be configured individually using the `tailwindcss.lint.*` settings",
          "scope": "language-overridable"
        },
        "tailwindFix.lint.cssConflict": {
          "type": "string",
          "enum": [
            "ignore",
            "warning",
            "error"
          ],
          "default": "warning",
          "markdownDescription": "Class names on the same HTML element which apply the same CSS property or properties",
          "scope": "language-overridable"
        },
        "tailwindFix.lint.invalidApply": {
          "type": "string",
          "enum": [
            "ignore",
            "warning",
            "error"
          ],
          "default": "error",
          "markdownDescription": "Unsupported use of the [`@apply` directive](https://tailwindcss.com/docs/functions-and-directives/#apply)",
          "scope": "language-overridable"
        },
        "tailwindFix.lint.invalidScreen": {
          "type": "string",
          "enum": [
            "ignore",
            "warning",
            "error"
          ],
          "default": "error",
          "markdownDescription": "Unknown screen name used with the [`@screen` directive](https://tailwindcss.com/docs/functions-and-directives/#screen)",
          "scope": "language-overridable"
        },
        "tailwindFix.lint.invalidVariant": {
          "type": "string",
          "enum": [
            "ignore",
            "warning",
            "error"
          ],
          "default": "error",
          "markdownDescription": "Unknown variant name used with the [`@variants` directive](https://tailwindcss.com/docs/functions-and-directives/#variants)",
          "scope": "language-overridable"
        },
        "tailwindFix.lint.deprecatedAtRule": {
          "type": "string",
          "enum": [
            "ignore",
            "warning",
            "error"
          ],
          "default": "warning",
          "markdownDescription": "Deprecated Tailwind CSS at-rules",
          "scope": "language-overridable"
        },
        "tailwindFix.lint.invalidConfigPath": {
          "type": "string",
          "enum": [
            "ignore",
            "warning",
            "error"
          ],
          "default": "error",
          "markdownDescription": "Unknown or invalid path used with the [`theme` helper](https://tailwindcss.com/docs/functions-and-directives/#theme)",
          "scope": "language-overridable"
        },
        "tailwindFix.lint.invalidTailwindDirective": {
          "type": "string",
          "enum": [
            "ignore",
            "warning",
            "error"
          ],
          "default": "error",
          "markdownDescription": "Unknown value used with the [`@tailwind` directive](https://tailwindcss.com/docs/functions-and-directives/#tailwind)",
          "scope": "language-overridable"
        },
        "tailwindFix.lint.recommendedVariantOrder": {
          "type": "string",
          "enum": [
            "ignore",
            "warning",
            "error"
          ],
          "default": "warning",
          "markdownDescription": "Class variants not in the recommended order (applies in [JIT mode](https://tailwindcss.com/docs/just-in-time-mode) only)",
          "scope": "language-overridable"
        },
        "tailwindFix.lint.usedBlocklistedClass": {
          "type": "string",
          "enum": [
            "ignore",
            "warning",
            "error"
          ],
          "default": "warning",
          "markdownDescription": "Usage of class names that have been blocklisted via `@source not inline(…)`",
          "scope": "language-overridable"
        },
        "tailwindFix.lint.suggestCanonicalClasses": {
          "type": "string",
          "enum": [
            "ignore",
            "warning",
            "error"
          ],
          "default": "warning",
          "markdownDescription": "Indicate when utilities may be written in a more optimal form",
          "scope": "language-overridable"
        },
        "tailwindFix.experimental.classRegex": {
          "type": "array",
          "scope": "language-overridable"
        },
        "tailwindFix.experimental.configFile": {
          "type": [
            "null",
            "string",
            "object"
          ],
          "default": null,
          "markdownDescription": "Manually specify the Tailwind config file or files that should be read to provide IntelliSense features. Can either be a single string value, or an object where each key is a config file path and each value is a glob or array of globs representing the set of files that the config file applies to."
        },
        "tailwindFix.showPixelEquivalents": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show `px` equivalents for `rem` CSS values."
        },
        "tailwindFix.rootFontSize": {
          "type": "number",
          "default": 16,
          "markdownDescription": "Root font size in pixels. Used to convert `rem` CSS values to their `px` equivalents. See `#tailwindCSS.showPixelEquivalents#`."
        },
        "tailwindFix.inspectPort": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "markdownDescription": "Enable the Node.js inspector agent for the language server and listen on the specified port."
        },
        "tailwindFix.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Tailwind CSS Language Server."
        }
      }
    }
  },
  "scripts": {
    "_esbuild": "node ../../esbuild.mjs src/extension.ts src/server.ts src/cssServer.ts src/oxide-helper.ts --outdir=dist",
    "dev": "concurrently --raw --kill-others \"pnpm run watch\" \"pnpm run check --watch\"",
    "build": "pnpm run check && pnpm run clean && pnpm run _esbuild --minify && move-file dist/server.js dist/tailwindServer.js && move-file dist/cssServer.js dist/tailwindModeServer.js",
    "prepackage": "pnpm run build && pnpm run copy:notices",
    "package": "pnpm run prepackage && vsce package --no-dependencies",
    "publish": "pnpm run prepackage && vsce publish --no-dependencies",
    "copy:notices": "node -e \"const fs=require('fs'); if(fs.existsSync('../tailwindcss-language-server/ThirdPartyNotices.txt')) fs.copyFileSync('../tailwindcss-language-server/ThirdPartyNotices.txt', './dist/ThirdPartyNotices.txt');\"",



    "clean": "rimraf dist",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/class-fixer": "workspace:*",
    "@tailwindcss/language-server": "workspace:*",
    "@tailwindcss/language-service": "workspace:*",
    "@types/braces": "3.0.1",
    "@types/node": "^20.11.0",
    "@types/picomatch": "^2.3.3",

    "@types/vscode": "1.65.0",
    "@vscode/vsce": "2.21.1",
    "braces": "3.0.3",
    "color-name": "1.1.4",
    "concurrently": "9.1.2",
    "esbuild": "^0.28.1",
    "minimist": "^1.2.8",
    "move-file-cli": "3.0.0",
    "normalize-path": "3.0.0",
    "picomatch": "^4.0.1",
    "rimraf": "3.0.2",
    "typescript": "5.8.3",
    "vscode-languageclient": "8.0.2"
  }
}
